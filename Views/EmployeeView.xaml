<Window
    x:Class="TraceWPF.Views.EmployeeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="雇员管理"
    Width="1100"
    Height="700"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    FontFamily="{materialDesign:MaterialDesignFont}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1a1a2e" />
                <GradientStop Offset="0.5" Color="#16213e" />
                <GradientStop Offset="1" Color="#0f3460" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题区域  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                        Kind="AccountGroup" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                        Text="雇员管理系统">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="15"
                                Opacity="0.4"
                                ShadowDepth="0"
                                Color="#7C4DFF" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <TextBlock
                    Margin="56,8,0,0"
                    FontSize="14"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Opacity="0.7"
                    Text="管理公司员工信息，支持增删改查操作" />
            </StackPanel>

            <!--  主内容区域  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!--  雇员列表卡片  -->
                <materialDesign:Card
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    materialDesign:ElevationAssist.Elevation="Dp8"
                    Background="#252542">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="20,16" Background="#1e1e38">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                    Kind="FormatListBulleted" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                    Text="雇员列表" />
                                <TextBlock
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Opacity="0.6"
                                    Text="{Binding Employees.Count, StringFormat='共 {0} 人'}" />
                            </StackPanel>
                        </Border>

                        <DataGrid
                            Grid.Row="1"
                            Margin="0"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeColumns="True"
                            IsReadOnly="True"
                            ItemsSource="{Binding Employees}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedEmployee}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Name}"
                                    Header="姓名" />
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding Email}"
                                    Header="邮箱" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Department}"
                                    Header="部门" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Position}"
                                    Header="职位" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Salary, StringFormat=¥{0:N0}}"
                                    Header="薪资" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding HireDate, StringFormat=yyyy-MM-dd}"
                                    Header="入职日期" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!--  添加雇员表单卡片  -->
                <materialDesign:Card
                    Grid.Column="1"
                    materialDesign:ElevationAssist.Elevation="Dp8"
                    Background="#252542">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="20,16" Background="#1e1e38">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                    Kind="AccountPlus" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                    Text="添加雇员" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBox
                                    Margin="0,8,0,16"
                                    materialDesign:HintAssist.Hint="姓名"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox
                                    Margin="0,0,0,16"
                                    materialDesign:HintAssist.Hint="邮箱"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding NewEmployeeEmail, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox
                                    Margin="0,0,0,16"
                                    materialDesign:HintAssist.Hint="电话"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding NewEmployeePhone, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox
                                    Margin="0,0,0,16"
                                    materialDesign:HintAssist.Hint="部门"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding NewEmployeeDepartment, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox
                                    Margin="0,0,0,16"
                                    materialDesign:HintAssist.Hint="职位"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding NewEmployeePosition, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox
                                    Margin="0,0,0,24"
                                    materialDesign:HintAssist.Hint="薪资"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding NewEmployeeSalary, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        Height="44"
                                        Margin="0,0,8,0"
                                        Background="#7C4DFF"
                                        BorderBrush="#7C4DFF"
                                        Command="{Binding AddEmployeeCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="Plus" />
                                            <TextBlock VerticalAlignment="Center" Text="添加" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        Height="44"
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearInputFieldsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="Eraser" />
                                            <TextBlock VerticalAlignment="Center" Text="清空" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!--  底部操作区域  -->
            <materialDesign:Card
                Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                materialDesign:ElevationAssist.Elevation="Dp4"
                Background="#252542">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button
                            Height="44"
                            Padding="20,0"
                            Background="#EF5350"
                            BorderBrush="#EF5350"
                            Command="{Binding DeleteEmployeeCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Delete" />
                                <TextBlock VerticalAlignment="Center" Text="删除选中雇员" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Text="选中: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Text="{Binding SelectedEmployee.Name, TargetNullValue='未选择'}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
