<Window
    x:Class="TraceWPF.TestClusterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TraceWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TestClusterWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button
                x:Name="btnCreateDb"
                Width="120"
                Click="btnCreateDb_Click"
                Content="Create Db" />
            <Button
                x:Name="btnWrite"
                Width="120"
                Margin="10"
                Click="btnWrite_Click"
                Content="Write" />
            <Button
                x:Name="btnRead"
                Width="120"
                Click="btnRead_Click"
                Content="Read" />
        </WrapPanel>
    </Grid>
</Window>
